#pragma once

#include <cuda/std/atomic>
#include <cuda/std/type_traits>

namespace cuda {

namespace detail {

// Integer types supported by the compiler's 32-/64-bit atomic RMW built-ins.
template <class T>
concept atomic_integer =
  cuda::std::is_same_v<T, int> || cuda::std::is_same_v<T, unsigned int> ||
  cuda::std::is_same_v<T, long> || cuda::std::is_same_v<T, unsigned long> ||
  cuda::std::is_same_v<T, long long> || cuda::std::is_same_v<T, unsigned long long>;

}  // namespace detail

// NVRTC requires constant order/scope arguments. Scope is a template parameter;
// the switch below supplies a constant order for each built-in call.
template <detail::atomic_integer T, thread_scope Scope = thread_scope_system>
struct atomic_ref {
  T& ref;

  using value_type = T;

  __device__ explicit constexpr atomic_ref(T& t) noexcept : ref{t} {}

  __device__ T fetch_or(T v, memory_order order = memory_order_seq_cst) const noexcept
  {
    switch (order) {
      case memory_order_relaxed:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_RELAXED, static_cast<int>(Scope));
      case memory_order_consume:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_CONSUME, static_cast<int>(Scope));
      case memory_order_acquire:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_ACQUIRE, static_cast<int>(Scope));
      case memory_order_release:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_RELEASE, static_cast<int>(Scope));
      case memory_order_acq_rel:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_ACQ_REL, static_cast<int>(Scope));
      case memory_order_seq_cst:
        return __nv_atomic_fetch_or(&ref, v, __NV_ATOMIC_SEQ_CST, static_cast<int>(Scope));
    }
    __builtin_unreachable();
  }

  __device__ T fetch_and(T v, memory_order order = memory_order_seq_cst) const noexcept
  {
    switch (order) {
      case memory_order_relaxed:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_RELAXED, static_cast<int>(Scope));
      case memory_order_consume:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_CONSUME, static_cast<int>(Scope));
      case memory_order_acquire:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_ACQUIRE, static_cast<int>(Scope));
      case memory_order_release:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_RELEASE, static_cast<int>(Scope));
      case memory_order_acq_rel:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_ACQ_REL, static_cast<int>(Scope));
      case memory_order_seq_cst:
        return __nv_atomic_fetch_and(&ref, v, __NV_ATOMIC_SEQ_CST, static_cast<int>(Scope));
    }
    __builtin_unreachable();
  }

  __device__ T fetch_max(T const& v, memory_order order = memory_order_seq_cst) const noexcept
  {
    switch (order) {
      case memory_order_relaxed:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_RELAXED, static_cast<int>(Scope));
      case memory_order_consume:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_CONSUME, static_cast<int>(Scope));
      case memory_order_acquire:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_ACQUIRE, static_cast<int>(Scope));
      case memory_order_release:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_RELEASE, static_cast<int>(Scope));
      case memory_order_acq_rel:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_ACQ_REL, static_cast<int>(Scope));
      case memory_order_seq_cst:
        return __nv_atomic_fetch_max(&ref, v, __NV_ATOMIC_SEQ_CST, static_cast<int>(Scope));
    }
    __builtin_unreachable();
  }
};

template <class T>
atomic_ref(T&) -> atomic_ref<T>;

}  // namespace cuda
