#pragma once

#include <cuda/std/utility>

namespace cuda::std {

template <class E>
struct unexpected {
  using error_type = E;
  E value;

  constexpr explicit unexpected(E e) : value{e} {}

  constexpr E const& error() const { return value; }
};

template <class E>
unexpected(E) -> unexpected<E>;

template <class T, class E>
class expected {
  union {
    T value_;
    E error_;
  };
  bool valid_;

 public:
  using value_type = T;
  using error_type = E;

  constexpr expected() : value_{}, valid_{true} {}

  constexpr expected(T v) : value_{move(v)}, valid_{true} {}

  constexpr expected(unexpected<E> e) : error_{e.value}, valid_{false} {}

  constexpr explicit operator bool() const { return valid_; }

  constexpr bool has_value() const { return valid_; }

  constexpr T& operator*() { return value_; }

  constexpr T const& operator*() const { return value_; }

  constexpr T& value() { return value_; }

  constexpr T const& value() const { return value_; }

  constexpr E const& error() const { return error_; }
};

}  // namespace cuda::std
