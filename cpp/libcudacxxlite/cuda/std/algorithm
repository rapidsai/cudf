#pragma once

namespace cuda::std {

template <class T>
constexpr T const& min(T const& a, T const& b)
{
  return b < a ? b : a;
}

template <class T>
constexpr T const& max(T const& a, T const& b)
{
  return a < b ? b : a;
}

template <class T>
constexpr T clamp(T const& x, T const& lo, T const& hi)
{
  return min(max(x, lo), hi);
}

}  // namespace cuda::std
