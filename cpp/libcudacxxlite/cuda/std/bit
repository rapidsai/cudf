#pragma once

namespace cuda::std {

template <class To, class From>
__device__ constexpr To bit_cast(From const& x)
{
  return __builtin_bit_cast(To, x);
}

__device__ inline int countl_zero(unsigned int x) { return __clz(x); }

__device__ inline int countl_zero(unsigned long x) { return __clzll(x); }

__device__ inline int countl_zero(unsigned long long x) { return __clzll(x); }

namespace detail {

  template <class T>
constexpr int countr_zero(T x) noexcept
{
  if (x == 0) { return sizeof(T) * 8; }
  int count = 0;
  while ((x & T{1}) == 0) {
    ++count;
    x >>= 1;
  }
  return count;
}

template <class T>
constexpr int popcount(T x) noexcept
{
  int count = 0;
  while (x != 0) {
    ++count;
    x &= x - 1;
  }
  return count;
}

}  // namespace detail

constexpr int countr_zero(unsigned int x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::countr_zero(x); }
  return x ? __ffs(x) - 1 : 32;
}

constexpr int countr_zero(unsigned long x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::countr_zero(x); }
  return x ? __ffsll(x) - 1 : sizeof(x) * 8;
}

constexpr int countr_zero(unsigned long long x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::countr_zero(x); }
  return x ? __ffsll(x) - 1 : sizeof(x) * 8;
}

constexpr int popcount(unsigned int x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::popcount(x); }
  return __popc(x);
}

constexpr int popcount(unsigned long x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::popcount(x); }
  return __popcll(x);
}

constexpr int popcount(unsigned long long x) noexcept
{
  if (__builtin_is_constant_evaluated()) { return detail::popcount(x); }
  return __popcll(x);
}

}  // namespace cuda::std
