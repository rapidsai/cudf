#pragma once

#include <cuda/std/type_traits>

namespace cuda::std {

template <class T, class U>
concept convertible_to = is_convertible_v<T, U>;

template <class T, class U>
concept equality_comparable_with = requires(T a, U b) {
  a == b;
  a != b;
  b == a;
  b != a;
};

template <class T>
concept equality_comparable = equality_comparable_with<T, T>;

template <class T>
concept floating_point = is_floating_point_v<T>;

template <class T>
concept integral = is_integral_v<T>;

template <class T, class U>
concept same_as = is_same_v<T, U>;

template <class T, class U>
concept totally_ordered_with = equality_comparable_with<T, U> && requires(T a, U b) {
  a < b;
  a > b;
  a <= b;
  a >= b;
  b < a;
  b > a;
  b <= a;
  b >= a;
};

template <class T>
concept totally_ordered = totally_ordered_with<T, T>;

}  // namespace cuda::std
