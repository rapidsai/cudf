#pragma once

namespace cuda {

enum memory_order {
  memory_order_relaxed = __NV_ATOMIC_RELAXED,
  memory_order_consume = __NV_ATOMIC_CONSUME,
  memory_order_acquire = __NV_ATOMIC_ACQUIRE,
  memory_order_release = __NV_ATOMIC_RELEASE,
  memory_order_acq_rel = __NV_ATOMIC_ACQ_REL,
  memory_order_seq_cst = __NV_ATOMIC_SEQ_CST
};

enum thread_scope {
  thread_scope_system = __NV_THREAD_SCOPE_SYSTEM,
  thread_scope_device = __NV_THREAD_SCOPE_DEVICE,
  thread_scope_block  = __NV_THREAD_SCOPE_BLOCK,
  thread_scope_thread = __NV_THREAD_SCOPE_THREAD
};

}  // namespace cuda

namespace cuda::std {

using cuda::memory_order;

using cuda::memory_order_acq_rel;
using cuda::memory_order_acquire;
using cuda::memory_order_consume;
using cuda::memory_order_relaxed;
using cuda::memory_order_release;
using cuda::memory_order_seq_cst;

}  // namespace cuda::std
