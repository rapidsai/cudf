#pragma once

#include <cuda/std/cassert>
#include <cuda/std/cstddef>
#include <cuda/std/type_traits>

namespace cuda::std {

inline constexpr size_t dynamic_extent = size_t(-1);

template <class T, size_t Extent = dynamic_extent>
class span {
  T* ptr_;
  size_t len_;

 public:
  using element_type = T;
  using value_type   = remove_cv_t<T>;
  using size_type    = size_t;

  constexpr span() : ptr_{nullptr}, len_{} {}

  constexpr span(T* p, size_t n) : ptr_{p}, len_{n} {}

  constexpr T* data() const { return ptr_; }

  constexpr size_t size() const { return len_; }

  constexpr size_t size_bytes() const noexcept { return len_ * sizeof(T); }

  constexpr bool empty() const { return len_ == 0; }

  constexpr T& operator[](size_t n) const { return ptr_[n]; }

  constexpr T& at(size_t n) const
  {
    if (n >= len_) { __trap(); }
    return ptr_[n];
  }

  constexpr T& front() const noexcept
  {
    assert(!empty());
    return ptr_[0];
  }

  constexpr T& back() const noexcept
  {
    assert(!empty());
    return ptr_[len_ - 1];
  }

  constexpr T* begin() const { return ptr_; }

  constexpr T* end() const { return ptr_ + len_; }

  constexpr T const* cbegin() const noexcept { return ptr_; }

  constexpr T const* cend() const noexcept { return ptr_ + len_; }

  template <size_t Count>
  constexpr span<T, Count> first() const noexcept
  {
    static_assert(Extent == dynamic_extent || Count <= Extent, "span::first count out of range");
    assert(Count <= len_);
    return {ptr_, Count};
  }

  constexpr span<T> first(size_t count) const noexcept
  {
    assert(count <= len_);
    return {ptr_, count};
  }

  template <size_t Count>
  constexpr span<T, Count> last() const noexcept
  {
    static_assert(Extent == dynamic_extent || Count <= Extent, "span::last count out of range");
    assert(Count <= len_);
    return {ptr_ + (len_ - Count), Count};
  }

  constexpr span<T> last(size_t count) const noexcept
  {
    assert(count <= len_);
    return {ptr_ + (len_ - count), count};
  }

  template <size_t Offset, size_t Count = dynamic_extent>
  constexpr auto subspan() const noexcept -> span<T,
                                                  Count != dynamic_extent    ? Count
                                                  : Extent != dynamic_extent ? Extent - Offset
                                                                             : dynamic_extent>
  {
    static_assert(Extent == dynamic_extent || Offset <= Extent,
                  "span::subspan offset out of range");
    static_assert(Extent == dynamic_extent || Count == dynamic_extent || Count <= Extent - Offset,
                  "span::subspan count out of range");
    assert(Offset <= len_);
    assert(Count == dynamic_extent || Count <= len_ - Offset);
    return {ptr_ + Offset, Count == dynamic_extent ? len_ - Offset : Count};
  }

  constexpr span<T> subspan(size_t offset, size_t count = dynamic_extent) const noexcept
  {
    assert(offset <= len_);
    assert(count == dynamic_extent || count <= len_ - offset);
    return {ptr_ + offset, count == dynamic_extent ? len_ - offset : count};
  }
};

}  // namespace cuda::std
