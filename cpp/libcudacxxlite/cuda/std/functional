#pragma once

// cuDF's JIT headers use the min/max declarations provided transitively by CCCL functional.
#include <cuda/std/algorithm>
#include <cuda/std/utility>

namespace cuda::std {

template <class T = void>
struct divides {
  constexpr T operator()(T const& a, T const& b) const { return a / b; }
};

template <>
struct divides<void> {
  using is_transparent = void;

  template <class T, class U>
  constexpr auto operator()(T&& a, U&& b) const
    noexcept(noexcept(cuda::std::forward<T>(a) / cuda::std::forward<U>(b)))
      -> decltype(cuda::std::forward<T>(a) / cuda::std::forward<U>(b))
  {
    return cuda::std::forward<T>(a) / cuda::std::forward<U>(b);
  }
};

