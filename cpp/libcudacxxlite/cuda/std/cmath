#pragma once

#include <cuda/std/type_traits>

namespace cuda::std {

template <class T>
constexpr T abs(T x)
{
  return x < T(0) ? -x : x;
}

__device__ inline float acos(float x) noexcept { return ::acosf(x); }

__device__ inline double acos(double x) noexcept { return ::acos(x); }

template <class T>
  requires is_integral_v<T>
__device__ inline double acos(T x) noexcept
{
  return ::acos(static_cast<double>(x));
}

__device__ inline float acosh(float x) noexcept { return ::acoshf(x); }

__device__ inline double acosh(double x) noexcept { return ::acosh(x); }

