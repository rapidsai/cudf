#pragma once

#include <cuda/std/type_traits>

namespace cuda::ptx {

template <class Unsupported = void>
__device__ inline bool elect_sync(unsigned const& mask)
{
#if __CUDA_ARCH__ >= 900
  unsigned elected;
  asm volatile(
    "{\n\t"
    ".reg .pred leader;\n\t"
    "elect.sync _|leader, %1;\n\t"
    "selp.b32 %0, 1, 0, leader;\n\t"
    "}"
    : "=r"(elected)
    : "r"(mask));
  return static_cast<bool>(elected);
#else
  static_assert(!cuda::std::is_same_v<Unsupported, Unsupported>,
                "cuda::ptx::elect_sync requires SM90 or newer");
  return false;
#endif
}

}  // namespace cuda::ptx
